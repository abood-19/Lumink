# ---- Supabase (accounts, database, private photo storage) ----
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Gemini (sketch generator) ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Image model used for line-art generation (change if Google renames it)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Text model used to check that a request is about tattoos
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated owner emails that get full admin rights
ADMIN_EMAILS=

# Payments (Lemon Squeezy — merchant of record; pays out to banks in Uzbekistan)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_GOLD=
