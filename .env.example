# ---- Supabase (accounts, database, private photo storage) ----
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Gemini (sketch generator) ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cloudflare Workers AI (main image generator: ~170 free images/day, then ~$0.0006 per image)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Which generator to try first
AI_IMAGE_ORDER=cloudflare,gemini
# Optional. Leave empty: the app tries known models and, if Google retires one, picks a working model automatically.
GEMINI_IMAGE_MODEL=
GEMINI_TEXT_MODEL=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (Lemon Squeezy — merchant of record; pays out to banks in Uzbekistan)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_GOLD=
